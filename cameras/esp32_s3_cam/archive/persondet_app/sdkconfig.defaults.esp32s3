# ESP32-S3 defaults, adapted for the Waveshare ESP32-S3-CAM-OVxxxx
# (16MB QIO flash, 8MB octal PSRAM, GC0308 sensor, custom DVP pin map,
#  console on USB-Serial/JTAG)

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_CAMERA_CORE1=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# Waveshare ESP32-S3-CAM pin map (see LESSONS.md; NOT the real S3-EYE map)
CONFIG_CAMERA_MODULE_CUSTOM=y
CONFIG_CAMERA_PIN_PWDN=-1
CONFIG_CAMERA_PIN_RESET=-1
CONFIG_CAMERA_PIN_XCLK=38
CONFIG_CAMERA_PIN_SIOD=8
CONFIG_CAMERA_PIN_SIOC=7
CONFIG_CAMERA_PIN_VSYNC=17
CONFIG_CAMERA_PIN_HREF=18
CONFIG_CAMERA_PIN_PCLK=41
CONFIG_CAMERA_PIN_Y2=45
CONFIG_CAMERA_PIN_Y3=47
CONFIG_CAMERA_PIN_Y4=48
CONFIG_CAMERA_PIN_Y5=46
CONFIG_CAMERA_PIN_Y6=42
CONFIG_CAMERA_PIN_Y7=40
CONFIG_CAMERA_PIN_Y8=39
CONFIG_CAMERA_PIN_Y9=21

# GC0308 has no JPEG; example uses grayscale — make sure the driver is in
CONFIG_GC0308_SUPPORT=y

# Scores must print over the USB-C port (USB-Serial/JTAG), not UART0
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
